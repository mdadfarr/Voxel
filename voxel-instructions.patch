+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="referrer" content="no-referrer">
+<title>Voxel instructions</title>
+<link rel="stylesheet" href="/static/site.css">
+<style>
+/* Layout: one booklet page at a time. The 3D stage fills the page; the step number,
+   the parts box and (when the view turns) a turn badge sit on top of it at the top
+   left, like a LEGO step. Controls (back, a step slider, next) run along the bottom.
+   Page 0 is the cover, the last page is the parts list. Printing swaps all of this
+   for #print. */
+:root { --parts-bg: #d6e6f4; --new: #ffb800; }
+.book { padding: 20px 0 28px; display: grid; gap: 14px; }
+.book-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; }
+.book-head h1 { font-size: clamp(1.6rem, 4vw, 2.4rem); max-width: 24ch; }
+.book-head p { color: var(--soft); margin-top: 6px; }
+.tools { display: flex; gap: 8px; flex-wrap: wrap; }
+.btn {
+  font: 600 0.95rem/1 var(--body); color: var(--ink); background: var(--panel);
+  border: var(--edge); border-radius: var(--radius); padding: 10px 14px; cursor: pointer;
+}
+.btn:hover { background: var(--plate); }
+.btn.go { background: var(--yellow); }
+.btn.go:hover { background: #ffd62e; }
+.btn:disabled { opacity: 0.4; cursor: default; background: var(--panel); }
+
+.page { position: relative; height: min(70vh, 660px); min-height: 400px; overflow: hidden; background: #f4f7fa; }
+#stage { position: absolute; inset: 0; touch-action: none; cursor: grab; }
+#stage:active { cursor: grabbing; }
+#stage canvas { display: block; width: 100%; height: 100%; }
+
+.corner { position: absolute; top: 16px; left: 16px; right: 16px; display: flex; gap: 14px; align-items: flex-start; pointer-events: none; }
+.stepnum { font: 800 clamp(2.6rem, 7vw, 4.2rem)/0.9 var(--display); min-width: 1.2ch; }
+.callout {
+  background: var(--parts-bg);   /* light blue, like LEGO: white parts stay visible */
+  border: var(--edge); border-radius: var(--radius);
+  padding: 10px 12px; display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: flex-end; max-width: min(620px, 70%);
+}
+.callout figure { margin: 0; display: grid; justify-items: center; gap: 1px; width: 92px; }
+.callout img { width: 92px; height: 92px; object-fit: contain; }
+.callout figcaption { display: grid; justify-items: center; line-height: 1.1; text-align: center; }
+.callout figcaption b { font: 800 1.15rem/1 var(--display); }
+.callout figcaption span { font-size: 0.78rem; color: var(--ink); opacity: 0.75; }
+.turn {
+  display: flex; align-items: center; gap: 6px; background: var(--panel); border: var(--edge);
+  border-radius: 999px; padding: 6px 12px 6px 8px; font-weight: 600; font-size: 0.9rem; white-space: nowrap;
+}
+.turn svg { width: 26px; height: 26px; }
+.newkey { position: absolute; right: 16px; bottom: 14px; display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--soft); pointer-events: none; }
+.newkey i { width: 22px; height: 14px; border: 3px solid var(--new); border-radius: 3px; display: inline-block; }
+.newkey .arrowkey { width: 22px; height: 4px; background: #d01012; position: relative; margin-left: 10px; display: inline-block; }
+.newkey .arrowkey::after { content: ""; position: absolute; right: -6px; top: -5px; border: 7px solid transparent; border-left: 8px solid #d01012; border-right: 0; }
+
+.cover { position: absolute; left: 16px; bottom: 16px; pointer-events: none; }
+.cover .btn { pointer-events: auto; }
+.cover p { font: 600 1rem/1.4 var(--body); color: var(--soft); margin-bottom: 10px; }
+
+.loading { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; padding: 20px; color: var(--soft); background: #f4f7fa; }
+
+.list { position: absolute; inset: 0; overflow: auto; padding: 20px; background: var(--panel); }
+.list h2 { margin-bottom: 4px; }
+.list > div > p { color: var(--soft); margin-bottom: 16px; }
+.list h3 { margin: 18px 0 8px; display: flex; align-items: center; gap: 8px; }
+.list h3 i { width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--ink); display: inline-block; }
+.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 10px; }
+.cell { background: var(--parts-bg); border: 2px solid var(--plate-dot); border-radius: var(--radius); padding: 8px; display: grid; justify-items: center; text-align: center; gap: 2px; }
+.cell img { width: 92px; height: 92px; object-fit: contain; }
+.cell b { font: 800 1.1rem/1 var(--display); }
+.cell span { font-size: 0.8rem; line-height: 1.25; }
+.cell small { font-size: 0.72rem; color: var(--soft); }
+.cell .from { font-style: normal; font-size: 0.72rem; font-weight: 600; color: var(--ink); background: var(--panel); border-radius: 999px; padding: 1px 7px; margin-top: 2px; }
+.sets { display: flex; flex-wrap: wrap; gap: 8px; margin: -6px 0 14px; }
+.setchip { border: 2px solid var(--ink); border-radius: 999px; padding: 4px 12px; font-size: 0.85rem; background: var(--panel); }
+
+.bar { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; padding: 12px; }
+.bar input[type="range"] { width: 100%; accent-color: var(--red); }
+.where { text-align: center; font-weight: 600; margin-top: 2px; }
+.hint { color: var(--soft); font-size: 0.85rem; text-align: center; }
+
+#print { display: none; }
+.overlay { position: fixed; inset: 0; background: rgba(22, 25, 30, 0.55); display: grid; place-items: center; z-index: 10; }
+.overlay div { background: var(--panel); border: var(--edge); border-radius: var(--radius); padding: 20px 26px; font-weight: 600; }
+
+@media (max-width: 640px) {
+  .page { height: 64vh; }
+  .callout figure { width: 60px; }
+  .callout img { width: 60px; height: 60px; }
+  .callout { max-width: 100%; }
+  .corner { flex-wrap: wrap; }
+  .newkey { display: none; }
+  .bar { grid-template-columns: 1fr 1fr; }
+  .bar .mid { grid-column: 1 / -1; order: -1; }
+}
+
+/* --- Printing: one booklet page per sheet --- */
+@page { size: landscape; margin: 12mm; }
+@media print {
+  html, body { background: #fff; }
+  .callout, .cell, .turn, .newkey i, .newkey .arrowkey { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
+  body > :not(#print) { display: none !important; }
+  #print { display: block; }
+  .ppage { break-after: page; position: relative; height: 180mm; display: flex; flex-direction: column; }
+  .ppage:last-child { break-after: auto; }
+  .ppage .pimg { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; }
+  .ppage .pimg img { max-width: 100%; max-height: 100%; object-fit: contain; }
+  .ppage .corner { position: absolute; top: 0; left: 0; right: 0; }
+  .ppage .callout { max-width: 70%; }
+  .pcover h1 { font-size: 2.4rem; max-width: none; }
+  .pcover p { color: var(--soft); margin-top: 6px; }
+  .ppage .list { position: static; padding: 0; }
+  .ppage.plist { height: auto; break-inside: auto; }
+  .cell { break-inside: avoid; }
+  .list h3 { break-after: avoid; }
+  .pfoot { position: absolute; right: 0; bottom: 0; font-weight: 600; color: var(--soft); }
+  .ppage .newkey { left: 0; right: auto; bottom: 0; }
+}
+</style>
+</head>
