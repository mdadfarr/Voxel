diff --git a/tests/test_instructions.py b/tests/test_instructions.py
new file mode 100644
index 0000000..7a147ed
--- /dev/null
+++ b/tests/test_instructions.py
@@ -0,0 +1,214 @@
+"""voxel.instructions: the stepped LDraw text becomes the instructions page's data."""
+
+import json
+
+import bricklayer as bl
+import pytest
+
+from test_site import request, served, upstream  # noqa: F401  (fixtures)
+from voxel.instructions import (
+    INSTRUCTIONS_FILE,
+    NoSteps,
+    build_instructions,
+    main,
+    read_steps,
+    record_instructions,
+    short_name,
+    stepped_ldr,
+    write_instructions,
+)
+from voxel.sequence import sequence, stepped_build
+from voxel.serve import ldraw_response, model_text
+
+# Two steps: a red 2x4 brick and a black plate, then two red bricks on top.
+STEPPED = """\
+1 4 40 -24 20 1 0 0 0 1 0 0 0 1 3001.dat
+1 0 40 -8 60 1 0 0 0 1 0 0 0 1 3020.dat
+0 STEP
+1 4 40 -48 20 1 0 0 0 1 0 0 0 1 3001.dat
+1 4 40 -48 60 1 0 0 0 1 0 0 0 1 3001.dat
+0 STEP
+"""
+RECORD = "20260101-000000-a-red-wall-abc12345"
+
+
+def test_steps_split_at_step_markers():
+    steps = read_steps(STEPPED)
+    assert [len(s) for s in steps] == [2, 2]
+    assert steps[0][0] == {"code": 4, "file": "3001.dat", "matrix": [40, -24, 20, 1, 0, 0, 0, 1, 0, 0, 0, 1]}
+
+
+def test_callouts_count_parts_per_step_and_the_list_counts_them_all():
+    data = build_instructions(STEPPED, "a red wall")
+    assert data["title"] == "a red wall" and data["pieces"] == 4
+    assert [c["name"] for c in data["colors"]] == ["Red", "Black"]
+    assert data["colors"][0]["hex"] == "#C91A09"
+    assert [p["id"] for p in data["parts"]] == ["3001", "3020"]
+    assert data["parts"][0]["name"] == "Brick 2 x 4" and data["parts"][0]["short"] == "2x4 brick"
+    assert data["steps"][0]["callout"] == [{"part": 0, "color": 0, "count": 1}, {"part": 1, "color": 1, "count": 1}]
+    assert data["steps"][1]["callout"] == [{"part": 0, "color": 0, "count": 2}]
+    assert data["steps"][1]["bricks"] == [2, 3]
+    assert [b["step"] for b in data["bricks"]] == [1, 1, 2, 2]
+    # sorted by color name: Black before Red
+    assert data["parts_list"] == [{"part": 1, "color": 1, "count": 1}, {"part": 0, "color": 0, "count": 3}]
+
+
+def test_no_markers_is_one_step_and_empty_steps_are_dropped():
+    text = "0 STEP\n" + STEPPED.replace("0 STEP\n", "") + "0 STEP\n0 STEP\n"
+    assert [len(s) for s in read_steps(text)] == [4]
+
+
+def test_no_parts_raises():
+    with pytest.raises(NoSteps):
+        read_steps("0 STEP\n0 a comment\n")
+
+
+def test_unknown_color_code_gets_a_gray_and_a_plain_name():
+    data = build_instructions("1 9999 0 0 0 1 0 0 0 1 0 0 0 1 3001.dat\n")
+    assert data["colors"][0]["name"] == "Color 9999" and data["colors"][0]["hex"].startswith("#")
+
+
+def test_sub_files_are_expanded_with_their_placement_and_color():
+    text = (
+        "0 FILE main.ldr\n"
+        "1 4 0 0 0 1 0 0 0 1 0 0 0 1 3001.dat\n"
+        "0 STEP\n"
+        "1 1 100 0 0 1 0 0 0 1 0 0 0 1 group.ldr\n"
+        "0 STEP\n"
+        "0 FILE group.ldr\n"
+        "1 16 0 -24 0 1 0 0 0 1 0 0 0 1 3001.dat\n"
+        "1 0 20 -24 0 1 0 0 0 1 0 0 0 1 3001.dat\n"
+    )
+    steps = read_steps(text)
+    assert [len(s) for s in steps] == [1, 2]
+    assert steps[1][0]["code"] == 1  # 16 takes the color of the line that placed the group
+    assert steps[1][0]["matrix"][:3] == [100, -24, 0]
+    assert steps[1][1]["code"] == 0 and steps[1][1]["matrix"][:3] == [120, -24, 0]
+
+
+def test_matches_the_computed_sequence():
+    """The instructions have exactly the pages voxel.sequence computes."""
+    build = bl.LegoBuild()
+    build.add(bl.Element("3958", bl.Color.LIGHT_BLUISH_GRAY), (0, 0, 0))  # 6x6 plate
+    for k in range(9):  # 9 1x1 plates on it: more than one step's worth
+        build.add(bl.Element("3024", bl.Color.RED), (k % 6, k // 6, 1 / 3))
+    pages = sequence(build).pages
+    data = build_instructions(bl.to_ldraw(stepped_build(build, pages)))
+    assert [len(s["bricks"]) for s in data["steps"]] == [len(p) for p in pages]
+    assert sum(r["count"] for r in data["parts_list"]) == 10
+
+
+def make_record(records, name=RECORD, files=None):
+    record = records / name
+    (record / "out").mkdir(parents=True)
+    for path, text in (files or {}).items():
+        (record / path).write_text(text, encoding="utf-8")
+    return record
+
+
+def test_stepped_ldr_prefers_the_stepped_file_and_needs_markers_in_build_ldr(tmp_path):
+    record = make_record(tmp_path, files={"out/build.ldr": STEPPED.replace("0 STEP\n", "")})
+    assert stepped_ldr(record) is None  # build.ldr without markers is not a manual
+    (record / "out" / "build.ldr").write_text(STEPPED, encoding="utf-8")
+    assert stepped_ldr(record).name == "build.ldr"
+    (record / "out" / "build.stepped.ldr").write_text(STEPPED, encoding="utf-8")
+    assert stepped_ldr(record).name == "build.stepped.ldr"
+
+
+def test_title_is_the_typed_request(tmp_path):
+    record = make_record(
+        tmp_path, files={"out/build.stepped.ldr": STEPPED, "settings.json": json.dumps({"request": "a red wall"})}
+    )
