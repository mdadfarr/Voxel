+
+  /* ---------- part pictures: one angle, one scale ----------
+     Every picture uses the same orthographic camera and the same studs-per-pixel, so a 1x1 plate
+     looks small next to a 2x4 brick. Only parts too big for the square are shrunk to fit. */
+  const thumbs = new Map();   // "part|color" -> data URL
+  {
+    const T = 184, FIT = 2.1;  // FIT: half the square's width in studs (a 2x4 brick fits with room)
+    const tr = new THREE.WebGLRenderer({ antialias: true, alpha: true, preserveDrawingBuffer: true });
+    tr.setSize(T, T, false); tr.outputEncoding = THREE.sRGBEncoding; tr.setClearColor(0x000000, 0);
+    const ts = new THREE.Scene(); studio(tr, ts);
+    const tc = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.01, 2000);
+    const dir = new THREE.Vector3(Math.sin(HOME.az) * Math.cos(0.55), Math.sin(0.55), Math.cos(HOME.az) * Math.cos(0.55));
+    for (const [k, [pi, ci]] of need) {
+      const copy = partCopy(pi, ci, -1); if (!copy) continue;
+      const f = new THREE.Group(); f.scale.set(0.05, -0.05, -0.05); f.add(copy.g); ts.add(f);
+      f.updateMatrixWorld(true);
+      const bb = new THREE.Box3().setFromObject(f), c = bb.getCenter(new THREE.Vector3());
+      const half = Math.max(FIT, bb.getSize(new THREE.Vector3()).length() * 0.53);
+      Object.assign(tc, { left: -half, right: half, top: half, bottom: -half });
+      tc.updateProjectionMatrix();
+      tc.position.copy(c).addScaledVector(dir, 200); tc.lookAt(c);
+      tr.render(ts, tc);
+      thumbs.set(k, tr.domElement.toDataURL("image/png"));
+      ts.remove(f); copy.mats.forEach((m) => m.dispose());
+    }
+    tr.dispose();
+  }
+  const thumb = (row) => {
+    const img = el("img"); img.src = thumbs.get(row.part + "|" + row.color) || ""; img.alt = label(row); img.title = label(row);
+    return img;
+  };
+  function calloutFor(step) {
+    return DATA.steps[step - 1].callout.map((row) => {
+      const f = el("figure"), cap = el("figcaption");
+      cap.append(el("b", "", row.count + "x"), el("span", "", shortLabel(row)));
+      f.title = label(row); f.append(thumb(row), cap); return f;
+    });
+  }
+  const TURN_SVG = '<svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 19a10 6 0 1 0 6-8" fill="none" stroke="#16191e" stroke-width="2.6" stroke-linecap="round"/><path d="M14 6l-1.6 5.4 5.4 1" fill="none" stroke="#16191e" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
+  function turnBadge(into, view) { into.innerHTML = TURN_SVG; into.append(document.createTextNode("Turn the model: " + view.name)); }
+
+  /* ---------- pages ---------- */
+  let page = 0, glows = [], started = false, turned = false;
+  const GLOW = new THREE.Color(0xfff1b3);
+  function show(next, animate) {
+    next = Math.max(0, Math.min(LAST, next));
+    const forward = next === page + 1;
+    page = next;
+    const isStep = page >= 1 && page <= STEPS;
+    const shownStep = isStep ? page : STEPS;
+    for (const b of bricks) if (b) { b.holder.visible = b.step <= shownStep; b.float.set(0, 0, 0); b.holder.position.set(0, 0, 0); for (const m of b.mats) m.emissiveIntensity = 0; }
+    glows = [];
