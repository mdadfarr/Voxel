+      for (const b of fresh) { for (const m of b.mats) m.emissive.copy(GLOW); glows.push({ b, t: 0 }); }
+    }
+    const view = viewFor(page);
+    turned = isStep && page > 1 && viewFor(page - 1) !== view;
+    current = view; goal.az = near(view.az, rig.az); goal.el = view.el;
+
+    $("loading").hidden = true;
+    $("cover").hidden = page !== 0;
+    $("list").hidden = page !== LAST;
+    $("corner").hidden = !isStep;
+    $("newkey").hidden = !isStep;
+    if (isStep) {
+      $("stepnum").textContent = page;
+      $("callout").replaceChildren(...calloutFor(page));
+      $("turn").hidden = !turned;
+      if (turned) turnBadge($("turn"), view);
+    }
+    $("where").textContent = page === 0 ? "Cover" : page === LAST ? "Parts list" : "Step " + page + " of " + STEPS;
+    $("slider").value = page;
+    $("bPrev").disabled = page === 0;
+    $("bNext").disabled = page === LAST;
+    $("bNext").innerHTML = page === 0 ? "Start &rarr;" : page === STEPS ? "Parts list &rarr;" : "Next &rarr;";
+    history.replaceState(null, "", page ? "#step-" + page : location.pathname);
+    frameGoal(!started); started = true;   // after the parts box is filled: its height is kept free
+  }
+
+  function partsList(into) {
+    const wrapper = el("div");
+    wrapper.append(el("h2", "", "Parts list"), el("p", "", DATA.pieces + " pieces, all from your own sets. Pictures are to scale."));
+    if (DATA.sets && DATA.sets.length) {   // which of your sets to open, and how many pieces come from each
+      const sets = el("div", "sets");
+      for (const s of DATA.sets) {
+        const chip = el("span", "setchip"); chip.append(el("b", "", "Set " + s.set), document.createTextNode(" " + s.pieces + " pieces"));
+        sets.append(chip);
+      }
+      wrapper.append(sets);
+    }
+    const byColor = new Map();
+    for (const row of DATA.parts_list) { if (!byColor.has(row.color)) byColor.set(row.color, []); byColor.get(row.color).push(row); }
+    for (const [ci, rows] of byColor) {
+      const h = el("h3"); const dot = el("i"); dot.style.background = DATA.colors[ci].hex;
+      h.append(dot, document.createTextNode(DATA.colors[ci].name + " (" + rows.reduce((s, r) => s + r.count, 0) + ")"));
+      const grid = el("div", "grid");
+      for (const row of rows) {
+        const c = el("div", "cell"); c.title = label(row);
+        c.append(thumb(row), el("b", "", row.count + "x"), el("span", "", shortLabel(row)), el("small", "", DATA.parts[row.part].id));
