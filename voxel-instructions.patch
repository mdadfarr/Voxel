+    if (isStep) {   // hard-to-see parts are lifted off their spot, with an arrow to it
+      const lay = layoutFor(page);
+      for (const b of fresh) { const m = lay.moves.get(b); if (m) { b.float.copy(toLocal(m)); b.holder.position.copy(b.float); } }
