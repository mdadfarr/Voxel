+++ b/src/voxel/instructions.py
@@ -0,0 +1,310 @@
+"""Turn a stepped build into instructions.json for the instructions page.
+
+The input is the stepped LDraw file Voxel already writes (out/build.stepped.ldr,
+or out/build.ldr when it has step markers): part lines with a `0 STEP` after
+each page. Only that text is read; build.py is never run, so the website can
+make instructions for any finished record safely.
+
+What the page gets, like a LEGO booklet:
+- steps: the parts each step adds, and a callout (part, color, how many);
+- parts_list: every part and color with its count, for the back pages;
+- bricks: every part's LDraw file, color and placement, so the page can draw
+  the model as it stands after each step.
+
+Run it on an existing record:
+    python -m voxel.instructions <record_id> [--records-dir records]
+It writes out/instructions.json in the record.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from collections import Counter
+from pathlib import Path
+
+import bricklayer as bl
+
+from .export import _compose, _mat, _name
+
+FORMAT_VERSION = 1
+INSTRUCTIONS_FILE = "instructions.json"
+STEPPED_SOURCES = ("build.stepped.ldr", "build.ldr")  # first one with step markers wins
+UNKNOWN_HEX = "#9BA19D"  # a neutral gray for color codes BrickLayer does not know
+
+
+class NoSteps(ValueError):
+    """The LDraw text has no parts."""
+
+
+def _color(code: int) -> dict:
+    for c in bl.Color:
+        if c.ldraw_id == code:
+            return {
+                "code": code,
+                "name": c.display_name,
+                "hex": "#" + str(c.rgb).lstrip("#").upper(),
+                "trans": "TRANS" in c.finish.name,
+            }
+    return {"code": code, "name": f"Color {code}", "hex": UNKNOWN_HEX, "trans": False}
+
+
+_SIZE = re.compile(r"(\d+)\s*x\s*(\d+)(?:\s*x\s*(\d+))?")
+_SHAPES = ("round", "corner", "curved", "inverted", "double", "wedge", "arch", "cone", "dish")
+
+
+def short_name(name: str) -> str:
+    """A label that fits under a part picture: "Tile 1 x 4 with Groove" -> "1x4 tile",
+    "Plate 1 x 1 Round with Bar" -> "1x1 round plate with bar", "Slope 45 2 x 2" -> "2x2 slope"."""
+    words = name.replace("~", "").replace("=", "").replace("_", " ").split()
+    if not words:
+        return name
+    kind = words[0].lower()
+    size = _SIZE.search(name)
+    if not size:
+        return " ".join(words[:3]).lower()[:28]
+    dims = "x".join(g for g in size.groups() if g)
+    lowered = name.lower()
+    shapes = [s for s in _SHAPES if re.search(rf"\b{s}\b", lowered)]
+    tail = " with bar" if re.search(r"\bwith bar\b", lowered) else ""
+    return " ".join([dims, *shapes, kind]) + tail
+
+
+def _part_id(file: str) -> str:
+    name = file.replace("\\", "/").rsplit("/", 1)[-1]
+    return name[:-4] if name.lower().endswith(".dat") else name
+
+
+def read_steps(text: str) -> list[list[dict]]:
+    """The parts of each step, in order: {"code", "file", "matrix"} per part.
+
+    `matrix` is LDraw's 12 numbers in line order (x y z a b c d e f g h i), in
+    world space. Steps are split at `0 STEP` (and `0 ROTSTEP`) lines of the main
+    model. Sub-files (`0 FILE ...`) are expanded into their parts; an empty step
+    is dropped.
+    """
+    blocks: dict[str, list[list[str]]] = {}
+    main: list[list[str]] = []
+    current: list[list[str]] | None = None
+    main_name: str | None = None
+    for raw in text.splitlines():
+        line = raw.split()
+        if len(line) >= 3 and line[0] == "0" and line[1] == "FILE":
+            name = raw.split(None, 2)[2].strip().lower()
+            current = blocks.setdefault(name, [])
+            main_name = main_name or name
+            continue
+        target = main if current is None or (main_name is not None and current is blocks.get(main_name)) else current
+        if line and line[0] == "1" and len(line) >= 15:
+            target.append(line)
+        elif len(line) >= 2 and line[0] == "0" and line[1] in ("STEP", "ROTSTEP"):
+            target.append(["STEP"])
+
+    identity = ([[1, 0, 0], [0, 1, 0], [0, 0, 1]], [0, 0, 0])
+
+    def leaves(lines, world, color, depth):
+        for t in lines:
+            if t == ["STEP"]:
+                continue
+            code = int(t[1]) if int(t[1]) != 16 else color
+            m = _compose(world, _mat(t[2:14]))
+            sub = t[14].lower()
+            if sub in blocks and depth < 20 and blocks[sub] is not main:
+                yield from leaves(blocks[sub], m, code, depth + 1)
+            else:
+                rot, trans = m
+                matrix = [round(v, 4) for v in trans + [v for row in rot for v in row]]
+                yield {"code": code, "file": t[14], "matrix": matrix}
+
+    steps: list[list[dict]] = [[]]
+    for t in main:
+        if t == ["STEP"]:
+            steps.append([])
+        else:
+            steps[-1].extend(leaves([t], identity, 16, 0))
+    steps = [s for s in steps if s]
+    if not steps:
+        raise NoSteps("the LDraw file has no parts")
+    return steps
+
+
+def _sources(entries: list[dict] | None) -> dict[tuple[str, int], list[tuple[str, int]]]:
+    """(part id, LDraw color code) -> [(set number, pieces)], from inventory entries with "sets"."""
+    out: dict[tuple[str, int], list[tuple[str, int]]] = {}
+    for entry in entries or []:
+        sets = entry.get("sets") if isinstance(entry, dict) else None
+        if not isinstance(sets, dict):
+            continue
+        raw = entry.get("color")
+        try:
+            code = raw if isinstance(raw, int) else bl.Color[str(raw).upper()].ldraw_id
+        except KeyError:
+            continue
+        key = (str(entry.get("part", "")).lower(), code)
+        out.setdefault(key, []).extend((str(s), int(n)) for s, n in sets.items() if int(n) > 0)
+    return out
+
+
+def build_instructions(text: str, title: str = "", inventory: list[dict] | None = None) -> dict:
+    """The JSON-ready instructions for one stepped LDraw text. With the record's inventory
+    (entries that say which sets their pieces come from), every parts list line also says
+    which sets to take its pieces from."""
+    steps = read_steps(text)
+    colors: list[dict] = []
+    parts: list[dict] = []
+    color_at: dict[int, int] = {}
+    part_at: dict[str, int] = {}
+    bricks: list[dict] = []
+    out_steps: list[dict] = []
+
+    for number, step in enumerate(steps, start=1):
+        ids: list[int] = []
+        callout: Counter[tuple[int, int]] = Counter()
+        for leaf in step:
+            code = leaf["code"]
+            if code not in color_at:
+                color_at[code] = len(colors)
+                colors.append(_color(code))
+            pid = _part_id(leaf["file"])
+            if pid.lower() not in part_at:
+                part_at[pid.lower()] = len(parts)
+                name = _name(pid)
+                parts.append({"id": pid, "name": name, "short": short_name(name), "file": leaf["file"]})
+            pi, ci = part_at[pid.lower()], color_at[code]
+            ids.append(len(bricks))
+            bricks.append({"part": pi, "color": ci, "step": number, "matrix": leaf["matrix"]})
+            callout[(pi, ci)] += 1
+        out_steps.append(
+            {
+                "number": number,
+                "bricks": ids,
+                # first-seen order, like the parts box in a LEGO step
+                "callout": [{"part": p, "color": c, "count": n} for (p, c), n in callout.items()],
+            }
+        )
+
+    totals: Counter[tuple[int, int]] = Counter((b["part"], b["color"]) for b in bricks)
+    parts_list = sorted(
+        ({"part": p, "color": c, "count": n} for (p, c), n in totals.items()),
+        key=lambda row: (colors[row["color"]]["name"], parts[row["part"]]["name"], parts[row["part"]]["id"]),
+    )
+    # where each piece comes from: take from the sets in order until the count is met
+    sources = _sources(inventory)
+    used: Counter[str] = Counter()
+    for row in parts_list:
+        offers = sources.get((parts[row["part"]]["id"].lower(), colors[row["color"]]["code"]), [])
+        need, take = row["count"], []
+        for set_num, have in offers:
+            n = min(need, have)
+            if n > 0:
+                take.append({"set": set_num, "count": n})
+                used[set_num] += n
+                need -= n
+            if not need:
+                break
+        if take:
+            row["sets"] = take
+    return {
+        "version": FORMAT_VERSION,
+        "sets": [{"set": s, "pieces": n} for s, n in used.most_common()],
+        "title": title,
+        "units": "LDraw units (1 stud = 20 LDU, -y is up)",
+        "pieces": len(bricks),
+        "colors": colors,
+        "parts": parts,
+        "bricks": bricks,
+        "steps": out_steps,
+        "parts_list": parts_list,
+    }
+
+
+def stepped_ldr(record: Path) -> Path | None:
+    """The record's stepped LDraw file, or None when it has none."""
+    for name in STEPPED_SOURCES:
+        path = record / "out" / name
+        if path.is_file():
+            if name == STEPPED_SOURCES[0]:
+                return path
+            text = path.read_text(encoding="utf-8", errors="replace")
+            if any(line.split()[:2] == ["0", "STEP"] for line in text.splitlines()):
+                return path
+    return None
+
+
+def record_title(record: Path) -> str:
+    """What the person asked for (the website's own rule), or ""."""
+    from .site import typed_request  # here, not at the top: site imports this module
+
+    try:
+        meta = json.loads((record / "meta.json").read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        meta = {}
+    return typed_request(record, meta if isinstance(meta, dict) else {})
+
+
+INVENTORY_FILE = "inventory.json"  # in the record (voxel.webjob copies it there)
+
+
+def record_inventory(record: Path) -> list[dict] | None:
+    try:
+        data = json.loads((record / INVENTORY_FILE).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    return data if isinstance(data, list) else None
+
+
+def record_instructions(record: Path) -> dict | None:
+    """Instructions for a record, from its stepped LDraw file; None when it has none."""
+    source = stepped_ldr(record)
+    if source is None:
+        return None
+    text = source.read_text(encoding="utf-8", errors="replace")
+    return build_instructions(text, record_title(record), record_inventory(record))
+
+
+def write_instructions(record: Path) -> Path | None:
+    """Write out/instructions.json for a record. Returns the path, or None when
+    the record has no stepped LDraw file."""
+    data = record_instructions(record)
+    if data is None:
+        return None
+    out = record / "out" / INSTRUCTIONS_FILE
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(data, separators=(",", ":")) + "\n", encoding="utf-8")
+    return out
+
+
+def main(argv: list[str] | None = None) -> int:
+    """0: written. 1: no record, no stepped file, or the file has no parts."""
+    from brickwright.config import default_records_dir
+
+    parser = argparse.ArgumentParser(
+        prog="python -m voxel.instructions",
+        description="Write out/instructions.json for an existing record (no API call, build.py is not run).",
+    )
+    parser.add_argument("record_id")
+    parser.add_argument(
+        "--records-dir", type=Path, default=None, help="default: BRICKWRIGHT_RECORDS_DIR or records"
+    )
+    args = parser.parse_args(argv)
+    record = (args.records_dir or default_records_dir()) / args.record_id
+    try:
+        out = write_instructions(record)
+    except NoSteps as err:
+        print(f"Error: {err}", file=sys.stderr)
+        return 1
+    if out is None:
+        print(
+            f"Error: {record / 'out'} has no stepped build; run python -m voxel.sequence {args.record_id} first",
+            file=sys.stderr,
+        )
+        return 1
+    data = json.loads(out.read_text(encoding="utf-8"))
+    print(f"Wrote {out}: {data['pieces']} pieces in {len(data['steps'])} steps")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
